# 允许 audio HAL 访问 /mnt/vendor/nvdata
allow hal_audio_default nvdata_file:file { read open getattr };
allow hal_audio_default nvdata_file:dir search;

# 允许 audio HAL 访问 /dev/ccci_*
allow hal_audio_default ccci_device:chr_file { read write open ioctl map };

# 允许 audio HAL 访问 /sys/firmware/...
allow hal_audio_default sysfs:file { read open getattr };
allow hal_audio_default sysfs_dt_firmware_android:dir search;
allow hal_audio_default sysfs_dt_firmware_android:file { read open getattr };

# 允许 audio HAL 连接 property_service
allow hal_audio_default property_socket:sock_file write;
allow hal_audio_default init:unix_stream_socket connectto;